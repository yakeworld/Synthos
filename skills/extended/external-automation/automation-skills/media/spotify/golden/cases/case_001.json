    "sequence": [
      {"tool": "spotify_search", "args": {"query": "miles davis kind of blue", "types": ["album"], "limit": 1}},
      {"tool": "spotify_playback", "args": {"action": "play", "context_uri": "spotify:album:1weenld61qoidwYuZ1GESA"}}
    ],
    "result": {"status": "success", "is_playing": true},
