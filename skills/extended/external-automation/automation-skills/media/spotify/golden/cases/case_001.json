  "input": {
    "request": "play miles davis kind of blue",
    "context": {
      "user_tier": "premium",
      "active_device": true,
      "intent_type": "album",
      "search_mock": {
        "tool": "spotify_search",
        "args": {"query": "miles davis kind of blue", "types": ["album"], "limit": 1},
        "returns": {"uri": "spotify:album:1weenld61qoidwYuZ1GESA"}
      }
    }
  },
  "expected": {
